    "axios": "1.17.0",
    "esbuild": ">=0.25.0",
    "postcss": "8.5.15",
    "eslint": "9.39.4",
    "zod": "3.25.76",
    "mongoose": "8.24.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3"
  }

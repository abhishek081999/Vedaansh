{
  "name": "jyotish-platform",
  "version": "2.6.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node --max-old-space-size=450 --expose-gc ./node_modules/next/dist/bin/next start",
    "lint": "node scripts/assert-eslint-version.mjs && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:engine": "vitest run",
    "test:security": "vitest run __tests__/security",
    "security:check": "npm run test:security",
    "security:preflight": "npm run security:check",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:dev": "npm audit --audit-level=moderate",
    "security:audit:summary": "npm audit",
    "test:watch": "vitest src/lib/engine",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "tsx scripts/render-reel.ts",
    "reel:mp4": "tsx scripts/render-reel.ts",
    "test:mongo": "node scripts/test-mongo-connection.mjs"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",

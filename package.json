{
  "name": "jyotish-platform",
  "version": "2.6.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node --max-old-space-size=450 --expose-gc ./node_modules/next/dist/bin/next start",
    "lint": "node scripts/assert-eslint-version.mjs && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:engine": "vitest run",
    "test:security": "vitest run __tests__/security",
    "security:check": "npm run test:security",
    "security:preflight": "npm run security:check",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:dev": "npm audit --audit-level=moderate",
    "security:audit:summary": "npm audit",
    "test:watch": "vitest src/lib/engine",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "tsx scripts/render-reel.ts",
    "reel:mp4": "tsx scripts/render-reel.ts",
    "test:mongo": "node scripts/test-mongo-connection.mjs",
    "android:update": "npx --yes @bubblewrap/cli update --manifest=android-twa",
    "android:build": "npx --yes @bubblewrap/cli build --manifest=android-twa --skipPwaValidation",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/android-twa-build.ps1",
    "android:sign": "powershell -ExecutionPolicy Bypass -File scripts/android-sign.ps1",
    "android:fingerprint": "powershell -ExecutionPolicy Bypass -File scripts/android-fingerprint.ps1"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@remotion/player": "^4.0.477",
    "@serwist/next": "^9.5.11",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.1.3",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.18.0",
    "mongodb": "^7.3.0",
    "mongoose": "9.7.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.25",
    "razorpay": "^2.9.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0",
    "remotion": "^4.0.477",
    "resend": "^6.12.4",
    "sharp": "^0.35.1",
    "stripe": "^22.2.1",
    "sweph": "^2.10.3-5",
    "tailwind-merge": "^3.3.1",
    "typescript": "^6.0.3",
    "tz-lookup": "^6.1.25",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@remotion/bundler": "^4.0.448",
    "@remotion/cli": "^4.0.448",
    "@remotion/renderer": "^4.0.448",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/jszip": "^3.4.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "^4.1.8",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "postcss": "8.5.15",
    "serwist": "^9.5.11",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "axios": "1.17.0",
    "esbuild": ">=0.25.0",
    "postcss": "8.5.15",
    "eslint": "9.39.4",
    "zod": "4.4.3",
    "mongoose": "9.7.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3"
  }
}

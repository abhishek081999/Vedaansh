# ─────────────────────────────────────────────
#  VEDAANSH — Environment Variables
#  Copy this file to .env.local and fill values
# ─────────────────────────────────────────────

# ── MongoDB Atlas ──────────────────────────────
# Use mongodb+srv://... (default). If you see querySrv ECONNREFUSED locally, add the
# Atlas "Standard connection string" below (mongodb://user:pass@host1,host2/...).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/vedaansh?retryWrites=true&w=majority
# Optional — bypasses SRV DNS (recommended fix for querySrv ECONNREFUSED on Windows)
# MONGODB_URI_DIRECT=mongodb://USERNAME:PASSWORD@ac-xxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/vedaansh?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGODB_DB_NAME=vedaansh

# ── NextAuth.js v5 ─────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── Upstash Redis (required in production for rate limiting) ──
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Extra hosts allowed for same-origin CSRF checks (comma-separated URLs)
# CSRF_TRUSTED_ORIGINS=https://staging.vedaansh.com

# Production checklist (full guide: docs/SECURITY_DEPLOY.md):
# - UPSTASH_REDIS_* set (rate limits fail-closed in production)
# - RAZORPAY_WEBHOOK_SECRET set (webhooks return 503 if missing in production)
# - AUTH_SECRET rotated; AUTH_URL=https://your-domain
# - MongoDB Atlas IP allowlist + backups enabled
# - Render/host logs: filter on "[security-event]" for alerts
# - Cloudflare WAF enabled on production domain (recommended)
# - Run `npm run security:audit` after dependency updates
# - Admin read APIs and Razorpay webhooks are rate-limited (Redis in production)
# - POST APIs enforce Content-Length body caps (413 when exceeded)
# - npm install uses legacy-peer-deps (.npmrc) for React 19 peer ranges
# - xlsx is pinned to SheetJS 0.20.3 CDN build; axios forced to 1.17.0 via overrides

# ── Swiss Ephemeris ────────────────────────────
EPHE_PATH=./ephe

# ── Razorpay (live checkout) ─────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Stripe (schema ready; checkout not wired) ─
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# ── Email (Resend) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@vedaansh.com
# Optional: security.txt contact (defaults to FROM_EMAIL)
# SECURITY_CONTACT_EMAIL=security@vedaansh.com

# ── App URLs ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vedaansh
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── SEO (optional) ─────────────────────────────
# Google Search Console HTML tag verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

  "method": {
    "label": "पद्धति",
    "classical": {
      "name": "शास्त्रीय",
      "topic": "ग्रंथ के नियम। अर्गला ग्रह-संख्या और बल से रुकती है। स्थिर दशा ब्रह्मा से आरंभ होती है। मंडूक में वृश्चिक और कुंभ के सह-स्वामी लगते हैं। पाँचवाँ कारक कुंडली में पितृकारक ही रहता है।"
    },
    "practical": {
      "name": "व्यावहारिक",
      "topic": "व्यावहारिक पाठ। अर्गला केवल विपरीत अंश-चतुर्थांश से रुकती है, फिर बल से तुलना होती है। स्थिर दशा लग्न और सप्तम में जो प्रबल हो वहीं से चलती है। मंडूक में केवल मंगल और शनि। पाँचवाँ कारक पुत्रकारक है।"
    }
  },

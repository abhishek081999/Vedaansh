    "sunAdityaFree": "प्रमुख आदित्य और मूल कारकत्व की निःशुल्क झलक। Gold में सभी 12 आदित्य, आध्यात्मिक टिप्पणियाँ और कठिन प्रभाव।",
    "sunHousesFull": "भाव-दर-भाव सूर्य टिप्पणियाँ, साथ में सूर्य–चंद्र (अमावस्या), मंगल, बुध, गुरु, शुक्र, शनि, राहु और केतु की युति — जन्म का भाव और सक्रिय युतियाँ चिह्नित।",
    "sunHousesFree": "जन्म सूर्य के भाव और सक्रिय युति की निःशुल्क झलक। Gold में सभी 12 भाव, पूरी युति सूची और उपाय।",
    "moonFull": "पूर्ण चंद्र शिक्षा: पक्ष बली, चंद्र + त्रिपुर सुंदरी की 16 कलाएँ, कारकत्व, वैदिक उद्धरण, आठ चरणों का विश्लेषण, नीच भंग, सात मन, और पूर्वजन्म / ग्रहण — कुंडली से जुड़ी बातें चिह्नित।",
    "moonFree": "पक्ष बली, दोनों सक्रिय कलाओं (चंद्र + त्रिपुर) और प्रमुख मन की निःशुल्क झलक। Gold में आधार, दोनों कला पद्धतियाँ, मन, विश्लेषण का ढाँचा और पूर्वजन्म संदर्भ।",
    "marsFull": "पूर्ण मंगल शिक्षा: भाव + राशि + ग्रह के मिश्रित फल, शास्त्रीय सूचियाँ, उपचय (वृद्धि भाव: 3, 6, 10, 11), 4/7/8 दृष्टियाँ, कलाएँ, मंगल–केतु और उपाय — जन्म की बातें चिह्नित।",
    "marsFree": "जन्म मंगल के भाव, उपचय (वृद्धि भाव: 3, 6, 10, 11) और मिश्रित फल की निःशुल्क झलक। Gold में पूरे मिश्रित स्तर, सूचियाँ, दृष्टियाँ, मंगल–केतु और उपाय।",
    "mercuryFull": "पूर्ण बुध शिक्षा: कारकत्व, पौराणिक कथा, शास्त्रीय सूचियाँ, भाव की कठिनाई (9/7/12), अस्त/वक्री के गुण और छाया, युति का साथ और उपाय — जन्म की बातें चिह्नित।",
    "mercuryFree": "जन्म बुध के भाव, युति के साथी और अस्त/वक्री संकेतों की निःशुल्क झलक। Gold में कारकत्व, सूचियाँ, भाव शिक्षा, स्थितियाँ और उपाय।",
    "jupiterFull": "पूर्ण बृहस्पति शिक्षा: कारकत्व, शास्त्रीय सूचियाँ, भाव में विलंब और दुःस्थान (कठिन भाव: 6, 8, 12) में उलटफेर, 5/7/9 दृष्टियाँ, गुरु-चांडाल/केतु/मंगल/शनि योग, केंद्राधिपति, अस्त/वक्री और उपाय — जन्म की बातें चिह्नित।",
    "jupiterFree": "जन्म गुरु के भाव, दृष्टियों, योग संकेतों और अस्त/वक्री की निःशुल्क झलक। Gold में कारकत्व, सूचियाँ, योगों का विवरण, स्थितियाँ और उपाय।",
    "venusFull": "पूर्ण शुक्र शिक्षा: पौराणिक कथा, कारकत्व, 16 कलाएँ, पाँच अवस्थाएँ, दुःस्थान (6/8/12), उच्च/नीच/वक्री/अस्त, युति योग, ययाति कथा और उपाय — जन्म की बातें चिह्नित।",
    "venusFree": "जन्म शुक्र के भाव, युति, दुःस्थान (कठिन भाव: 6, 8, 12) संकेतों और अस्त/वक्री की निःशुल्क झलक। Gold में कारकत्व, 16 कलाएँ, सूचियाँ, योग और पौराणिक कथा।",
    "saturnFull": "पूर्ण शनि शिक्षा: कारकत्व, कंटक केंद्र (केंद्र भाव: 1, 4, 7, 10), 3/7/10 दृष्टियाँ, विष/शापित योग, साढ़े साती के पाद, वक्री/अस्त, पौराणिक कथा और उपाय — जन्म की बातें चिह्नित।",
    "saturnFree": "जन्म शनि के भाव, कंटक, दृष्टियों और योग/अस्त/वक्री संकेतों की निःशुल्क झलक। Gold में कारकत्व, साढ़े साती के पाद, सूचियाँ और परंपरा।",
    "rahuFull": "पूर्ण राहु शिक्षा: कारकत्व, उपचय (वृद्धि भाव: 3, 6, 10, 11) / शत्रु हंता, अष्ट लक्ष्मी, अंगारक और गुरु-चांडाल योग, नक्षत्र, पौराणिक कथा, काल सर्प का स्पष्टीकरण, और दशा बनाम गोचर — जन्म की बातें चिह्नित।",
    "rahuFree": "जन्म राहु के भाव, उपचय (वृद्धि भाव: 3, 6, 10, 11) / शत्रु हंता संकेतों और सक्रिय योगों की निःशुल्क झलक। Gold में कारकत्व, सूचियाँ, अष्ट लक्ष्मी और परंपरा।",
    "ketuFull": "पूर्ण केतु शिक्षा: कारकत्व, धर्म/मोक्ष त्रिकोण, दृष्टि-रहित अक्ष, महादशा बनाम अंतर्दशा, युति योग, नक्षत्र, उपाय और फलादेश की नैतिकता — जन्म की बातें चिह्नित।",
    "ketuFree": "जन्म केतु के भाव, धर्म/मोक्ष संकेतों और सक्रिय योगों की निःशुल्क झलक। Gold में कारकत्व, सूचियाँ, महादशा बनाम अंतर्दशा और परंपरा।",
    "remediesFull": "हर ग्रह के लिए व्यवहारिक, आध्यात्मिक, दान और सेवा के उपाय — जन्म की पीड़ा (गरिमा, अस्त, वक्री, युद्ध, गंडांत, षड्बल) के क्रम में, उस नक्षत्र देवता के साथ जो उपाय को सटीक ऊर्जा देता है।",
    "remediesFree": "आपके दो सबसे पीड़ित ग्रहों के संकेतों और व्यवहारिक उपायों की निःशुल्क झलक। Gold में सभी नौ ग्रह, आध्यात्मिक उपाय, दान, सेवा और सावधानियाँ।",
    "energyFull": "शास्त्रीय चक्र शिक्षा से ऊर्जा के रूप — शनि का बाँधना/छोड़ना, गुरु की शांति की आयु, शुक्र के पाद की इच्छाएँ, वायु राशियों में सूर्य के अधिकार का बदलाव, और बहुत कुछ। महादशा से स्वतंत्र।",
    "energyFree": "दो चक्रों की निःशुल्क झलक। सभी नौ ग्रहों के चरण, समय-खिड़कियाँ और कुंडली से जुड़ी टिप्पणियों के लिए Gold लें।",
    "heroSub": "जन्म की स्थितियाँ, गरिमा और ग्रहों की ऊर्जा के रूप — चल रही दशा से स्वतंत्र।",
    "overviewHint": "D1 और D9 साथ-साथ, जल्दी देखने के लिए ग्रहों के सूक्ष्म विवरण के साथ।",
    "detailsHint": "हर ग्रह और विशेष बिंदु की राशि, नक्षत्र, KP स्वामी, गरिमा, ऊर्जा चक्र की झलक और षड्बल।",
